{
  "name": "gatsby-plugin-i18n",
  "version": "1.0.0",
  "description": "Gatsby plugin for internationalization (i18n) with react-i18next. Handles locale-prefixed routing, MDX locale detection, and translation loading.",
  "main": "index.js",
  "types": "index.d.ts",
  "license": "MIT",
  "keywords": [
    "gatsby",
    "gatsby-plugin",
    "i18n",
    "internationalization",
    "react-i18next"
  ],
  "scripts": {
    "lint": "eslint --max-warnings 0 .",
    "test": "jest --config jest.config.js",
    "test:coverage": "yarn test --coverage"
  },
  "peerDependencies": {
    "gatsby": "^5.0.0",
    "i18next": ">=21",
    "react": ">=18",
    "react-dom": ">=18",
    "react-i18next": ">=11"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/preset-env": "^7.29.5",
    "@babel/preset-react": "^7.28.5",
    "@ecocode/eslint-plugin": "0.2.0",
    "@eslint/compat": "^1.4.1",
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^9.39.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^14.3.1",
    "@types/react": "^18.3.28",
    "babel-jest": "^30.4.1",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jest": "^29.15.2",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-sonarjs": "^0.25.1",
    "globals": "^17.6.0",
    "i18next": "^23.16.8",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "prettier": "^3.8.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^14.1.3"
  }
}
